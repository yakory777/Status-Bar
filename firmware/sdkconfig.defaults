# --- LilyGO T-Display-S3 (LCD или AMOLED): ESP32-S3R8, флеш 16 МБ, PSRAM 8 МБ ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Своя таблица разделов (partitions.csv): программа 3 МБ, настройки — после неё, чтобы перепрошивка их не стирала
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Буферы Wi-Fi и сетевого стека — в PSRAM, чтобы внутренней памяти хватило на кадр экрана
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Скорость: оптимизация компилятора, QIO-флеш и кэш побольше (рисование на ЦП — главное узкое место) ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Логи — в тот же USB (Serial/JTAG), что и данные от ПК: на этой плате UART0 наружу не выведен,
# а так их видно в `idf.py monitor`. Демон показывает строки не-JSON как логи платы.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL 9 ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
