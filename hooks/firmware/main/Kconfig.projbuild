menu "Agent Status Bar"

config ASB_BUTTON_GPIO
    int "Button GPIO (BOOT button by default)"
    range -1 48
    default 0
    help
        Main button. GPIO0 is the BOOT button on the LilyGO T-Display-S3 AMOLED.

config ASB_BUTTON2_GPIO
    int "Second button GPIO (-1 = none)"
    range -1 48
    default -1
    help
        Optional second button that does the same as the first.
        On the non-touch T-Display-S3 AMOLED the user button is GPIO21;
        on the touch version GPIO21 is the touch interrupt, so leave -1.

config ASB_BUZZER_GPIO
    int "Passive buzzer GPIO (-1 = none)"
    range -1 48
    default -1
    help
        Passive piezo buzzer between this pin and GND (through ~100 Ω).
        Free pins on the board header include GPIO1, GPIO10–GPIO16, GPIO43, GPIO44.

config ASB_DISPLAY_SELFTEST
    bool "Flash red, green and blue at boot (display self-test)"
    default y
    help
        Before the UI starts, fill the screen red, green and blue for 0.4 s each.
        If you see the colours, the panel, its power and wiring work, and any
        remaining problem is in the UI. Turn off once the screen works.

choice ASB_LANGUAGE_CHOICE
    prompt "Screen language (until the host sends its own)"
    default ASB_LANGUAGE_EN
    help
        Labels drawn by the board. The daemon sends its configured language
        ("language" in ~/.agent-status/config.toml) on every update.

config ASB_LANGUAGE_EN
    bool "English"
config ASB_LANGUAGE_RU
    bool "Русский"
endchoice

config ASB_LANGUAGE
    string
    default "ru" if ASB_LANGUAGE_RU
    default "en"

endmenu
